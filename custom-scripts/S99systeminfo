#!/bin/sh
#
# Starts the SystemInfo HTTP server (systeminfo.py) on port 8080.
#

case "$1" in
  start)
	printf "Starting systeminfo server... "
	start-stop-daemon -S -q -b -m -p /var/run/systeminfo.pid \
		--exec /usr/bin/python3 -- /usr/bin/systeminfo.py
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  stop)
	printf "Stopping systeminfo server... "
	start-stop-daemon -K -q -p /var/run/systeminfo.pid
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
